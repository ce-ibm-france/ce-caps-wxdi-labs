{
  "name": "fx_rates_datagen_source",
  "config": {
    "connector.class": "io.confluent.kafka.connect.datagen.DatagenConnector",
    "tasks.max": "1",

    "kafka.topic": "fx_rates",

    "output.data.format": "AVRO",

    "quickstart": "",

    "schema.string": "{\"type\":\"record\",\"name\":\"FxRate\",\"namespace\":\"com.ibm.wxdi.lab\",\"fields\":[{\"name\":\"from_currency\",\"type\":{\"type\":\"string\",\"arg.properties\":{\"options\":[\"EUR\",\"GBP\",\"CHF\",\"CAD\",\"AUD\",\"NZD\",\"SEK\",\"NOK\",\"DKK\",\"SGD\"]}}},{\"name\":\"to_currency\",\"type\":{\"type\":\"string\",\"arg.properties\":{\"options\":[\"USD\",\"JPY\",\"CNY\",\"INR\",\"BRL\",\"MXN\",\"ZAR\",\"HKD\",\"KRW\",\"TRY\"]}}},{\"name\":\"rate\",\"type\":{\"type\":\"double\",\"arg.properties\":{\"range\":{\"min\":0.05,\"max\":200.0}}}}]}",

    "schema.keyfield": "from_currency",

    "iterations": "10000",
    "max.interval": "60000",

    "value.converter": "io.confluent.connect.avro.AvroConverter",
    "value.converter.schema.registry.url": "<SR_URL>",
    "value.converter.basic.auth.credentials.source": "USER_INFO",
    "value.converter.basic.auth.user.info": "<SR_USERNAME>:<SR_PASSWORD>",

    "key.converter": "org.apache.kafka.connect.storage.StringConverter"
  }
}
